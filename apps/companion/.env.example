# SpacetimeDB endpoint the browser connects to.
#   local:     ws://127.0.0.1:3000
#   maincloud: wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB=scalpal

# Authenticated replay URL resolution gateway (URLs are not persisted in RunResult).
VITE_API_URL=http://127.0.0.1:8788

# Volunteer vitals service (services/vitals, Presage).
VITE_VITALS_URL=http://127.0.0.1:8790

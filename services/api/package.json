{
  "name": "@scalpal/api",
  "private": true,
  "version": "0.1.0",
  "description": "Scalpal gateway: storage grants, provider credentials, motion worker bridge",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "worker:synthetic": "tsx --env-file-if-exists=.env scripts/synthetic-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "spacetimedb": "2.10.2",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2"
  }
}

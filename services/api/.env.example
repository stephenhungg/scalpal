# ---- HTTP -------------------------------------------------------------------
PORT=8788
# Public URL of this gateway (used in local-storage signed URLs).
PUBLIC_BASE_URL=http://localhost:8788
# Comma-separated browser origins allowed to call /files (local storage).
CORS_ORIGINS=http://localhost:5173

# ---- SpacetimeDB ------------------------------------------------------------
# local: ws://127.0.0.1:3000   maincloud: wss://maincloud.spacetimedb.com
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DB=scalpal
# Service identity token. Leave empty on first run: the gateway creates an
# identity, saves its token to SPACETIMEDB_TOKEN_FILE and prints the
# `spacetime call ... add_service_identity` command to register it. In
# production, copy that token here (as a secret) so the identity is stable.
SPACETIMEDB_TOKEN=
SPACETIMEDB_TOKEN_FILE=.gateway-token

# ---- Artifact storage -------------------------------------------------------
# 'local' (files on this machine, served by /files) or 's3' (R2 / S3).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/artifacts
URL_SIGNING_SECRET=change-me-to-a-long-random-string
# Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=scalpal-artifacts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Motion workers ---------------------------------------------------------
# workerId:token pairs (token >= 16 chars). Give Silas his own pair.
WORKER_TOKENS=synthetic:dev-synthetic-worker-token-0001
WORKER_LEASE_MS=60000

# ---- Voice provider (Jarvis) ------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=

# ---- WebRTC relay (needed when viewers are on other networks) ---------------
# Cloudflare Realtime TURN:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# or any TURN server:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Quest exercise scripts outside Unity (UnityEngine is stubbed) and plays every
       bundled case through CaseRunner. Run: npm run test:unity -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Unity suppresses CS0649 for [SerializeField] fields the inspector assigns. -->
    <NoWarn>CS0649</NoWarn>
    <!-- Compile what ships to the Quest: Android player code, editor-only branches excluded. -->
    <DefineConstants>UNITY_ANDROID;UNITY_5_3_OR_NEWER;SCALPAL_HANDS</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../apps/quest/Assets/Scalpal/Exercises/**/*.cs" />
    <!-- Anatomy runtime compiles here against the real CoachRelay; its editor tooling has its own check in scripts/anatomy/runtime-check. -->
    <Compile Include="../../../apps/quest/Assets/Scalpal/Anatomy/Runtime/*.cs" />
    <Compile Include="../../../apps/quest/Assets/Scalpal/Experience/**/*.cs" />
    <!-- Hand module, compiled with SCALPAL_HANDS as it is in a Quest project with Inference Engine and MRUK. -->
    <Compile Include="../../../apps/quest/Assets/Scalpal/Hands/**/*.cs" />
    <Compile Include="HandsStubs.cs" />
    <!-- Controller motion capture; main's instrument input is stubbed in RoboticsStubs.cs. -->
    <Compile Include="../../../apps/quest/Assets/Scalpal/Robotics/**/*.cs" />
    <Compile Include="RoboticsStubs.cs" />
    <Compile Include="UnityEngineStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>

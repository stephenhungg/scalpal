/finchnode-scenario-consent-partial","fhirSearch":"https://api.finchnode.com/demo/v1/fhir/Observation?patient=patient-demo-consent-partial","connect":"https://api.finchnode.com/demo/v1/connect/sessions"}},{"id":"source-unavailable","object":"demo_scenario","synthetic":true,"kind":"behavior","title":"One source unavailable","summary":"Two connected sources that each synced once. Quillhaven Medical Group now fails every sync, so the envelope reports partial sync status, a source_unavailable warning, and an older lastSyncedAt for that source.","subject":"patient-demo-source-unavailable","persona":{"displayName":"Ingrid Solano (synthetic)","sex":"female","birthYear":1958},"sources":[{"system":"northstar-health","organization":"Northstar Health System (Synthetic)"},{"system":"quillhaven-medical","organization":"Quillhaven Medical Group (Synthetic)"}],"categories":["demographics","medications","conditions","labs","vitals","allergies","immunizations","encounters"],"exercises":["meta.syncStatus partial","per-source lastSyncedAt","a source_unavailable warning in meta.warnings"],"behavior":"source_unavailable","behaviorConfig":{"unavailableSource":"quillhaven-medical"},"sessionOutcome":null,"controls":["consent.revoke","consent.expire","source.fail"],"bundleId":"finchnode-scenario-source-unavailable","links":{"self":"https://api.finchnode.com/demo/v1/scenarios/source-unavailable","patient":"https://api.finchnode.com/demo/v1/patients/patient-demo-source-unavailable","records":"https://api.finchnode.com/demo/v1/patients/patient-demo-source-unavailable/records","healthRecord":"https://api.finchnode.com/demo/v1/users/patient-demo-source-unavailable/records","fhirBundle":"https://api.finchnode.com/demo/v1/fhir/Bundle/finchnode-scenario-source-unavailable","fhirSearch":"https://api.finchnode.com/demo/v1/fhir/Observation?patient=patient-demo-source-unavailable","connect":"https://api.finchnode.com/demo/v1/connect/sessions"}},{"id":"connect-cancelled","object":"demo_scenario","synthetic":true,"kind":"session","title":"Connect session cancelled","summary":"A Connect session the patient abandons. The session is returned with status cancelled and no subject, the state an application must handle when a user backs out of authorization.","subject":null,"persona":null,"sources":[{"system":"northstar-health","organization":"Northstar Health System (Synthetic)"}],"categories":["demographics","medications","conditions","labs","vitals","allergies","immunizations","encounters"],"exercises":["cancelled session state","no subject on incomplete sessions"],"behavior":null,"behaviorConfig":null,"sessionOutcome":"cancelled","controls":[],"bundleId":null,"links":{"self":"https://api.finchnode.com/demo/v1/scenarios/connect-cancelled","connect":"https://api.finchnode.com/demo/v1/connect/sessions"}},{"id":"connect-failed","object":"demo_scenario","synthetic":true,"kind":"session","title":"Connect session failed","summary":"A Connect session whose source authorization fails. The session is returned with status failed and failure_code source_unavailable, matching the production failure taxonomy.","subject":null,"persona":null,"sources":[{"system":"northstar-health","organization":"Northstar Health System (Synthetic)"}],"categories":["demographics","medications","conditions","labs","vitals","allergies","immunizations","encounters"],"exercises":["failed session state","failure_code handling","offering the user a retry"],"behavior":null,"behaviorConfig":{"failureCode":"source_unavailable"},"sessionOutcome":"failed","controls":[],"bundleId":null,"links":{"self":"https://api.finchnode.com/demo/v1/scenarios/connect-failed","connect":"https://api.finchnode.com/demo/v1/connect/sessions"}}]}
demo/v1/connect/sessions"}},{"id":"messy-coding","object":"demo_scenario","synthetic":true,"kind":"record","title":"Messy coding, age 63","summary":"Free-text medications without RxNorm, an observation with no value, a code-only observation value, a reference range whose low bound is zero, an undated resource, weight in pounds, and glucose in mmol/L.","subject":"patient-demo-messy-coding","persona":{"displayName":"Dolores Marchetti (synthetic)","sex":"female","birthYear":1963},"sources":[{"system":"northstar-health","organization":"Northstar Health System (Synthetic)"}],"categories":["demographics","medications","conditions","labs","vitals","allergies","immunizations","encounters"],"exercises":["medications with text but no coding","observations with no value or a coded value","zero reference-range bounds","ICD-10-CM without SNOMED","non-default units"],"behavior":null,"behaviorConfig":null,"sessionOutcome":null,"controls":["records.advance","consent.revoke","consent.expire","source.fail"],"bundleId":"finchnode-scenario-messy-coding","links":{"self":"https://api.finchnode.com/demo/v1/scenarios/messy-coding","patient":"https://api.finchnode.com/demo/v1/patients/patient-demo-messy-coding","records":"https://api.finchnode.com/demo/v1/patients/patient-demo-messy-coding/records","healthRecord":"https://api.finchnode.com/demo/v1/users/patient-demo-messy-coding/records","fhirBundle":"https://api.finchnode.com/demo/v1/fhir/Bundle/finchnode-scenario-messy-coding","fhirSearch":"https://api.finchnode.com/demo/v1/fhir/Observation?patient=patient-demo-messy-coding","connect":"https://api.finchnode.com/demo/v1/connect/sessions"}},{"id":"rate-limited","object":"demo_scenario","synthetic":true,"kind":"behavior","title":"Rate limited reads","summary":"Reads fail with 429 and a Retry-After header during even two-second slots and succeed during odd slots. A client that waits the stated seconds succeeds on its next attempt.","subject":"patient-demo-rate-limited","persona":{"displayName
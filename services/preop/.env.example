# Copy to .env (gitignored). Never commit real keys.

# ElevenLabs: API key stays on this service; the browser only gets a short-lived signed URL.
ELEVENLABS_API_KEY=
# Printed by `npm run jarvis:setup` on first run.
ELEVENLABS_AGENT_ID=
# The pre-op patient interview agent, also printed by jarvis:setup.
PATIENT_AGENT_ID=

# Optional Jarvis agent settings used by `npm run jarvis:setup`.
# LLM inside the ElevenLabs agent. claude-sonnet-5-5 is the default; drop to claude-haiku-4-5 if turns feel slow.
JARVIS_LLM=claude-sonnet-5-5
# ElevenLabs voice id; blank keeps the account default.
JARVIS_VOICE_ID=
# none | minimal | low ... ; blank leaves the model default. Keep low for live voice.
JARVIS_REASONING=

# Optional FinchNode override (the public demo API needs no key).
FINCHNODE_BASE_URL=
# Optional FinchNode sandbox key (ck_test_...): enables POST /admit, a real Connect session with consent.
FINCHNODE_API_KEY=
PORT=8787

# Copy to .env (gitignored). Never commit real keys.

# ElevenLabs: API key stays on this service; the browser only gets a short-lived signed URL.
ELEVENLABS_API_KEY=
# Printed by `npm run jarvis:setup` on first run.
ELEVENLABS_AGENT_ID=
# The pre-op patient interview agent, also printed by jarvis:setup.
PATIENT_AGENT_ID=

# Optional Jarvis agent settings used by `npm run jarvis:setup`.
# LLM inside the ElevenLabs agent. claude-sonnet-5-5 is the default; drop to claude-haiku-4-5 if turns feel slow.
JARVIS_LLM=claude-sonnet-5-5
# ElevenLabs voice id; blank keeps the account default.
JARVIS_VOICE_ID=
# none | minimal | low ... ; blank leaves the model default. Keep low for live voice.
JARVIS_REASONING=

# Optional FinchNode override (the public demo API needs no key).
FINCHNODE_BASE_URL=
# Optional FinchNode sandbox key (ck_test_...): enables POST /admit, a real Connect session with consent.
FINCHNODE_API_KEY=
PORT=8787
# Browser origins allowed to call this service, comma separated (e.g. a deployed companion URL).
# localhost/127.0.0.1 on any port and this service's own pages (/jarvis, /jarvis/camera) are always
# allowed; other browser origins get 403. Unity sends no Origin header and is unaffected.
PREOP_CORS_ORIGINS=

# Shared SpacetimeDB session (optional). Jarvis joins as the coach role and mirrors the encounter,
# transcript, voice status, and highlight commands live. Local: `spacetime start` + publish the module.
SPACETIMEDB_URI=
SPACETIMEDB_DB=scalpal
# Coach invite code from the companion (or POST /realtime/join with it at runtime).
SPACETIMEDB_COACH_INVITE=
SPACETIMEDB_COACH_TOKEN_FILE=.coach-token

# Presage vitals service (services/vitals). At the AR Time-Out the coach captures the volunteer's measured
# baseline from it for the simulated monitor. Unset: the chart baseline stays. Run vitals on this same Mac.
VITALS_URL=http://127.0.0.1:8791

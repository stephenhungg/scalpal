+#if DEVELOPMENT_BUILD || UNITY_EDITOR
+    // Main-thread-only development telemetry. Persistent records; JSON allocates once per second.
+    internal static class QuestDetectionTelemetry
+    {
+        [System.Serializable]
+        internal sealed class InferenceRecord
+        {
+            public string Backend, CameraPosition, Outcome = "not_started";
+            public string GraphicsDeviceType, GraphicsDeviceName;
+            public bool SupportsComputeShaders;
+            public int InputWidth, InputHeight, TextureWidth, TextureHeight;
+            public float ScoreThreshold, IouThreshold;
+            public long Sequence, CaptureTimestampTicks, PreviousCaptureTimestampTicks;
+            public bool Paused, CameraPlaying, FreshTimestamp, UpdatedThisFrame, InFlight;
+            public Vector3 CachedPosePosition;
+            public Quaternion CachedPoseRotation;
+            public double BeginMs, CompleteMs, DurationMs, EndMs, TotalDurationMs, CompletedPerSecond;
+            public long LastCompletedSequence, LastCompletedCaptureTimestampTicks;
+            public string LastCompletedOutcome = "none";
+            public double LastCompletedBeginMs, LastCompletedMs, LastCompletedDurationMs;
+            public int LastCompletedDetectionCount = -1, LastCompletedBoxCount = -1;
+            public int LastCompletedClassIdCount = -1, LastCompletedScoreCount = -1;
+            public int LastCompletedBottleSelectedCount;
+            public float LastCompletedBottleMaxSelectedScore = -1, LastCompletedBottleMaxRawScore = -1;
+            public Vector3 LastCompletedCachedPosePosition;
+            public Quaternion LastCompletedCachedPoseRotation;
+            public int Started, Completed, NewTimestampInputs, RepeatedTimestampInputs;
+            public int CameraNotPlaying, HeadPoseUnreliable, EmptyOutputs, AnchorAbsent, AnchorUntracked;
+            public int CameraStoppedAfterInference, Drawn, Interrupted;
+            public int BoxCount = -1, ClassIdCount = -1, ScoreCount = -1, DetectionCount = -1;
+            public int AboveThresholdCount, BottleRawCount, BottleSelectedCount;
+            public float MaxRawScore = -1, BottleMaxRawScore = -1, BottleMaxSelectedScore = -1;
+        }
+
+        [System.Serializable]
+        internal sealed class PlacementRecord
+        {
+            public long InferenceSequence, CaptureTimestampTicks;
+            public long LastBottleHitSequence, LastBottleHitCaptureTimestampTicks;
+            public int DrawCalls, CenterRayHits, CenterRayMisses, BoxUpdates, RetainedBoxes;
+            public int BottleHits, BottleMisses;
+            public double LastDrawMs;
+            public float LastHitDistanceMeters = -1, LastBottleHitDistanceMeters = -1;
+            public Vector2 LastBottleNormalizedCenter;
+            public Vector3 LastBottleHitPoint;
+        }
+
+        [System.Serializable]
+        private sealed class Report
+        {
+            public string Type = "quest_detection_telemetry";
+            public double MonotonicMs, WindowSeconds;
+            public InferenceRecord Inference = new();
+            public PlacementRecord Placement = new();
+        }
+
+        private static Report s_report = new();
+        private static double s_windowStartMs;
+        private static long s_previousCaptureTicks;
+        internal static InferenceRecord Record => s_report.Inference;
+        internal static PlacementRecord Placement => s_report.Placement;
+        internal static double NowMs => System.Diagnostics.Stopwatch.GetTimestamp() * (1000.0 / System.Diagnostics.Stopwatch.Frequency);
+        internal static string LastReportJson { get; private set; }
+        internal static BackendType? RequestedBackend { get; set; }
+
+        internal static void Initialize(BackendType backend, Vector2Int inputSize, float iou, float score)
+        {
+            s_report = new Report();
+            LastReportJson = null;
+            s_previousCaptureTicks = 0;
+            s_windowStartMs = NowMs;
+            Record.Backend = backend.ToString();
+            Record.GraphicsDeviceType = SystemInfo.graphicsDeviceType.ToString();
+            Record.GraphicsDeviceName = SystemInfo.graphicsDeviceName;
+            Record.SupportsComputeShaders = SystemInfo.supportsComputeShaders;
+            Record.InputWidth = inputSize.x; Record.InputHeight = inputSize.y;
+            Record.IouThreshold = iou; Record.ScoreThreshold = score;
+        }
+
+        internal static void Skip(string reason)
+        {
+            Record.Outcome = reason;
+            if (reason == "camera_not_playing") Record.CameraNotPlaying++;
+            else Record.HeadPoseUnreliable++;
+        }
+
+        internal static void Begin(double beginMs, long captureTicks, Pose pose, PassthroughCameraAccess.CameraPositionType cameraPosition,
+            bool updatedThisFrame, int textureWidth, int textureHeight)
+        {
+            Record.Sequence++; Record.Started++; Record.InFlight = true;
+            Record.Outcome = "in_flight"; Record.BeginMs = beginMs; Record.CompleteMs = 0;
+            Record.DurationMs = 0; Record.EndMs = 0;
+            Record.PreviousCaptureTimestampTicks = s_previousCaptureTicks;
+            Record.CaptureTimestampTicks = captureTicks;
+            Record.FreshTimestamp = captureTicks != 0 && captureTicks != s_previousCaptureTicks;
+            if (Record.FreshTimestamp) Record.NewTimestampInputs++; else Record.RepeatedTimestampInputs++;
+            s_previousCaptureTicks = captureTicks;
+            Record.UpdatedThisFrame = updatedThisFrame;
+            Record.CameraPosition = cameraPosition == PassthroughCameraAccess.CameraPositionType.Left ? "Left" : "Right";
+            Record.TextureWidth = textureWidth; Record.TextureHeight = textureHeight;
+            Record.CachedPosePosition = pose.position; Record.CachedPoseRotation = pose.rotation;
+            Record.BoxCount = Record.ClassIdCount = Record.ScoreCount = Record.DetectionCount = -1;
+            Record.AboveThresholdCount = Record.BottleRawCount = Record.BottleSelectedCount = 0;
+            Record.MaxRawScore = Record.BottleMaxRawScore = Record.BottleMaxSelectedScore = -1;
+        }
+
+        internal static void Outputs(Tensor<int> classIDs, Tensor<float> scores, float threshold)
+        {
+            Record.ScoreCount = scores.shape[0];
+            var scoreArray = scores.AsReadOnlyNativeArray();
+            var classArray = classIDs.AsReadOnlyNativeArray();
+            for (int i = 0; i < scoreArray.Length; i++)
+            {
+                float score = scoreArray[i];
+                Record.MaxRawScore = Mathf.Max(Record.MaxRawScore, score);
+                if (score >= threshold) Record.AboveThresholdCount++;
+                if (i < classArray.Length && classArray[i] == 39)
+                {
+                    Record.BottleRawCount++;
+                    Record.BottleMaxRawScore = Mathf.Max(Record.BottleMaxRawScore, score);
+                }
+            }
+        }
+
+        internal static void Selected(int classId, float score)
+        {
+            if (classId != 39) return;
+            Record.BottleSelectedCount++;
+            Record.BottleMaxSelectedScore = Mathf.Max(Record.BottleMaxSelectedScore, score);
+        }
+
+        internal static void End(string outcome, double completeMs)
+        {
+            Record.InFlight = false; Record.Outcome = outcome; Record.EndMs = NowMs;
+            Record.CompleteMs = completeMs;
+            if (completeMs != 0)
+            {
+                Record.Completed++;
+                Record.DurationMs = completeMs - Record.BeginMs;
+                Record.TotalDurationMs += Record.DurationMs;
+                Record.LastCompletedSequence = Record.Sequence;
+                Record.LastCompletedCaptureTimestampTicks = Record.CaptureTimestampTicks;
+                Record.LastCompletedOutcome = outcome;
+                Record.LastCompletedBeginMs = Record.BeginMs;
+                Record.LastCompletedMs = completeMs;
+                Record.LastCompletedDurationMs = Record.DurationMs;
+                Record.LastCompletedDetectionCount = Record.DetectionCount;
+                Record.LastCompletedBoxCount = Record.BoxCount;
+                Record.LastCompletedClassIdCount = Record.ClassIdCount;
+                Record.LastCompletedScoreCount = Record.ScoreCount;
+                Record.LastCompletedBottleSelectedCount = Record.BottleSelectedCount;
+                Record.LastCompletedBottleMaxSelectedScore = Record.BottleMaxSelectedScore;
+                Record.LastCompletedBottleMaxRawScore = Record.BottleMaxRawScore;
+                Record.LastCompletedCachedPosePosition = Record.CachedPosePosition;
+                Record.LastCompletedCachedPoseRotation = Record.CachedPoseRotation;
+            }
+            switch (outcome)
+            {
+                case "empty_boxes": case "empty_class_ids": case "empty_scores": Record.EmptyOutputs++; break;
+                case "anchor_absent": Record.AnchorAbsent++; break;
+                case "anchor_untracked": Record.AnchorUntracked++; break;
+                case "camera_stopped_after_inference": Record.CameraStoppedAfterInference++; break;
+                case "drawn": Record.Drawn++; break;
+                case "interrupted_or_exception": Record.Interrupted++; break;
+            }
+        }
+
+        internal static void Tick(bool paused, bool cameraPlaying)
+        {
+            Record.Paused = paused; Record.CameraPlaying = cameraPlaying;
+            double now = NowMs;
+            if (now - s_windowStartMs < 1000) return;
+            s_report.MonotonicMs = now;
+            s_report.WindowSeconds = (now - s_windowStartMs) / 1000.0;
+            Record.CompletedPerSecond = Record.Completed / s_report.WindowSeconds;
+            LastReportJson = JsonUtility.ToJson(s_report);
+            Debug.Log("QuestDetectionTelemetry " + LastReportJson);
+            s_windowStartMs = now;
+            Record.Started = Record.Completed = Record.NewTimestampInputs = Record.RepeatedTimestampInputs = 0;
+            Record.CameraNotPlaying = Record.HeadPoseUnreliable = Record.EmptyOutputs = 0;
+            Record.AnchorAbsent = Record.AnchorUntracked = Record.CameraStoppedAfterInference = Record.Drawn = Record.Interrupted = 0;
+            Record.TotalDurationMs = 0;
+            Placement.DrawCalls = Placement.CenterRayHits = Placement.CenterRayMisses = Placement.BoxUpdates = 0;
+            Placement.BottleHits = Placement.BottleMisses = 0;
+        }
+    }
+#endif
 }
